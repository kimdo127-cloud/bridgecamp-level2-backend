# 이 파일을 .env로 복사해서 값을 채워 주세요.
# DB 주소: 로컬은 Render DB의 External 주소, Render 배포 서버는 Internal 주소
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME
# 이 과제가 쓰는 DB 안의 공간 이름 (Level 1은 level1)
DB_SCHEMA=level2
# 서버 포트 (Render는 자동으로 정해 줌)
PORT=4200
# 요청을 허락할 프론트엔드 주소. 여러 개면 쉼표로 구분
FRONTEND_ORIGIN=http://localhost:3200
# 챗봇용 OpenAI API 키 (프론트엔드·GitHub에 넣지 않음)
GPT_API_KEY=
# 로그인 토큰 서명용 비밀값 (아무 긴 무작위 문자열)
JWT_SECRET=
